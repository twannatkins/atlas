# Private build context — never committed
.claude-private/
*.local.md

# Standard
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.venv/
venv/
.DS_Store
node_modules/

# Notebook outputs (regenerated on run)
notebooks/**/output/

# Next.js build output (regenerated on every build)
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# Option C runtime packaging — transient pip-install + zip staging dir
# (scripts/build-runtimes.sh; the artifacts live in S3, never in git)
.runtime-build/

# Local infrastructure state
*.tfstate
.terraform/

# uv and tool caches
.uv/
.pytest_cache/
.ruff_cache/
delivery-plan/
.env.local
.env*.local
# env/config backups — never commit (they carry account-specific endpoints; the .f-bak
# files were the F-account-endpoint landmine — keep them out of history)
*.f-bak
*.f-orig

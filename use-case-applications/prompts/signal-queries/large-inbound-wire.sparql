# Large Inbound Wire Signal — SPARQL CONSTRUCT query
#
# Fired by wealth-signal-detector when a customer receives a wire
# transfer above the configured threshold within the observation window.
#
# Parameters:
#   {target_uri} — the atlas:Customer or atlas:Household URI to check
#   {threshold_amount} — minimum wire amount in USD (default: 500000)
#   {window_days} — observation window in days (default: 30)
#
# Validated against: atlas:WealthSignalTypeShape
# Signal strength: strong

PREFIX atlas: <https://github.com/your-org/atlas/ontology#>
PREFIX atlas-part-2: <https://github.com/your-org/atlas/ontology/part2#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
    ?signal a atlas:WealthSignal ;
        atlas:hasSignalType atlas-part-2:LargeInboundWireSignal ;
        atlas:aboutCustomer <{target_uri}> ;
        atlas:signalStrength "strong" ;
        atlas:evidencedBy ?txn ;
        prov:wasGeneratedBy <urn:atlas:wealth-signal-detector> ;
        prov:generatedAtTime ?now .
} WHERE {
    <{target_uri}> a atlas:Customer ;
        atlas:hasAccount ?acct .
    ?txn atlas:inAccount ?acct ;
        atlas:amountUSD ?amount ;
        atlas:transactionDate ?date .
    FILTER(?amount > {threshold_amount})
    BIND(NOW() AS ?now)
    BIND(IRI(CONCAT("atlas:signal/wire-", STRUUID())) AS ?signal)
}

# Segment Shift Signal — SPARQL CONSTRUCT query
#
# STATUS: DEFERRED to the session-intelligence phase. NOT enabled in
# wealth-signals.yaml (enabled: false). Phase-1 data cannot fire this honestly:
# the SLGD has no customer-segment/tier model and no temporal (prior-balance)
# dimension — accounts carry only a current balanceUSD, so there is no "crossing
# over time" to detect. A genuine segment shift needs the behavioural/velocity
# data (atlas-part-2:Session) the session-intelligence phase introduces.
# The body below is a SKETCH of the intended rule; it also uses atlas:inAccount,
# which is NOT in the ontology. Do NOT enable this until real temporal segment
# data exists and the query is reconciled to real predicates (atlas:producesSignal,
# etc.). See notebooks/phase-1-referral/05_wealth_signals.ipynb for the rationale.
#
# Fired (in the intended future state) by wealth-signal-detector when a customer's
# transaction velocity crosses a segment tier boundary (mass-market → mass-affluent,
# or mass-affluent → high-net-worth).
#
# Parameters:
#   {target_uri} — the atlas:Customer URI to check
#
# Validated against: atlas:WealthSignalTypeShape
# Signal strength: moderate

PREFIX atlas: <https://github.com/your-org/atlas/ontology#>
PREFIX atlas-part-2: <https://github.com/your-org/atlas/ontology/part2#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
    ?signal a atlas:WealthSignal ;
        atlas:hasSignalType atlas-part-2:SegmentShiftSignal ;
        atlas:aboutCustomer <{target_uri}> ;
        atlas:signalStrength "moderate" ;
        prov:wasGeneratedBy <urn:atlas:wealth-signal-detector> ;
        prov:generatedAtTime ?now .
} WHERE {
    <{target_uri}> a atlas:Customer ;
        atlas:hasAccount ?acct .
    ?txn atlas:inAccount ?acct ;
        atlas:amountUSD ?amount .
    BIND(NOW() AS ?now)
    BIND(IRI(CONCAT("atlas:signal/shift-", STRUUID())) AS ?signal)
}
GROUP BY ?acct
HAVING (SUM(?amount) > 250000)

{
  "agent_name": "theme-summarizer",
  "version": "1.0.0",
  "phase": 2,
  "posture": "probabilistic-draft-only",
  "description": "Summarizes market and portfolio themes from source articles for the Wealth UI Themes route.",
  "owner": "atlas-platform-team",
  "model_risk_classification": "tier-3-informational",
  "registry_record_type": "MCP",
  "runtime": {
    "type": "lambda",
    "handler": "theme_summarizer.handler",
    "runtime": "python3.12",
    "timeout_seconds": 30,
    "memory_mb": 1024,
    "environment_variables": {
      "SPARQL_MCP_ARN": "${atlas_sparql_mcp_arn}",
      "BEDROCK_TEXT_MODEL_ID": "anthropic.claude-sonnet-4-20250514-v1:0"
    }
  },
  "iam_policy": {
    "inline_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "bedrock:InvokeModel"
          ],
          "Resource": "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "lambda:InvokeFunction"
          ],
          "Resource": "${atlas_sparql_mcp_arn}"
        },
        {
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogStream",
            "logs:PutLogEvents"
          ],
          "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/theme-summarizer:*"
        }
      ]
    }
  },
  "input_schema": {
    "type": "object",
    "required": [
      "theme_uri",
      "persona_claim"
    ],
    "properties": {
      "theme_uri": {
        "type": "string"
      },
      "persona_claim": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "summary",
      "is_probabilistic"
    ],
    "properties": {
      "status": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "is_probabilistic": {
        "type": "boolean",
        "const": true
      },
      "source_articles": {
        "type": "array"
      }
    }
  },
  "registry_metadata": {
    "discoverable_by": [
      "atlas-wealth-advisor"
    ],
    "display_name": "Summarize theme",
    "display_icon": "newspaper",
    "capability_tag": "informational",
    "phase": 2
  },
  "dependencies": {
    "mcp_servers": [
      "atlas-sparql-mcp"
    ]
  }
}

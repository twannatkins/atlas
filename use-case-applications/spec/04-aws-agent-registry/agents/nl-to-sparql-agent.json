{
  "agent_name": "nl-to-sparql-agent",
  "version": "1.0.0",
  "phase": 1,
  "posture": "deterministic-audited",
  "description": "Translates natural-language questions into SPARQL queries against the Neptune SLGD using validated query templates. Foundational agent; deterministic by construction.",
  "owner": "atlas-platform-team",
  "model_risk_classification": "tier-2-interface",
  "mrm_submission_ref": "agentic-semantic-layer/docs/model-risk-review.md#nl-to-sparql",
  "registry_record_type": "MCP",
  "runtime": {
    "type": "lambda",
    "handler": "nl_to_sparql_agent.handler",
    "runtime": "python3.12",
    "timeout_seconds": 30,
    "memory_mb": 1024,
    "environment_variables": {
      "GROUND_TRUTH_S3_URI": "s3://atlas-workshop-1/prompts/ground-truth.yaml",
      "PREFIXES_S3_URI": "s3://atlas-workshop-1/prompts/prefixes.txt",
      "SPARQL_MCP_ARN": "${atlas_sparql_mcp_arn}",
      "BEDROCK_EMBEDDING_MODEL_ID": "amazon.titan-embed-text-v2:0"
    }
  },
  "iam_policy": {
    "managed_policies": [],
    "inline_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "bedrock:InvokeModel"
          ],
          "Resource": "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0"
        },
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject"
          ],
          "Resource": [
            "arn:aws:s3:::atlas-workshop-1/prompts/ground-truth.yaml",
            "arn:aws:s3:::atlas-workshop-1/prompts/prefixes.txt"
          ]
        },
        {
          "Effect": "Allow",
          "Action": [
            "bedrock-agentcore:InvokeAgentRuntime"
          ],
          "Resource": "${atlas_sparql_mcp_arn}"
        },
        {
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogStream",
            "logs:PutLogEvents"
          ],
          "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/nl-to-sparql-agent:*"
        }
      ]
    }
  },
  "input_schema": {
    "type": "object",
    "required": [
      "question",
      "persona_claim"
    ],
    "properties": {
      "question": {
        "type": "string",
        "description": "The natural-language question from the user",
        "maxLength": 500
      },
      "persona_claim": {
        "type": "string",
        "description": "The IDC group claim (e.g., 'atlas-consumer-banker')",
        "enum": [
          "atlas-consumer-banker",
          "atlas-wealth-advisor",
          "atlas-bsa-analyst",
          "atlas-ontology-steward",
          "atlas-auditor"
        ]
      },
      "session_id": {
        "type": "string",
        "description": "Optional session identifier for multi-turn conversations"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "status",
      "sparql",
      "result",
      "provenance"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "success",
          "no_template_match",
          "parameter_extraction_failed",
          "execution_error"
        ]
      },
      "sparql": {
        "type": "string",
        "description": "The SPARQL that was executed (empty on no_template_match)"
      },
      "result": {
        "type": "array",
        "description": "Query result rows"
      },
      "provenance": {
        "type": "object",
        "required": [
          "template_id",
          "parameters",
          "execution_time_ms"
        ],
        "properties": {
          "template_id": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "execution_time_ms": {
            "type": "number"
          }
        }
      },
      "clarification_request": {
        "type": "string",
        "description": "If status is parameter_extraction_failed, the clarification question to ask the user"
      }
    }
  },
  "registry_metadata": {
    "discoverable_by": [
      "atlas-consumer-banker",
      "atlas-wealth-advisor",
      "atlas-bsa-analyst",
      "atlas-ontology-steward"
    ],
    "display_name": "Ask the graph",
    "display_icon": "search",
    "capability_tag": "deterministic",
    "phase": 1
  },
  "dependencies": {
    "mcp_servers": [
      "atlas-sparql-mcp"
    ],
    "workshop_1_artifacts": [
      "agentic-semantic-layer/prompts/ground-truth.yaml",
      "agentic-semantic-layer/prompts/prefixes.txt"
    ]
  },
  "verification": {
    "test_questions": [
      {
        "question": "Which customers had a wire over $500k in the last 30 days?",
        "expected_template_id": "large-wire-customers",
        "expected_parameters": {
          "threshold_amount": 500000,
          "window_days": 30
        }
      },
      {
        "question": "Show me households with no advisor coverage.",
        "expected_template_id": "uncovered-households",
        "expected_parameters": {}
      }
    ],
    "determinism_check": "Run each test question 5 times; assert identical SPARQL output across all runs"
  }
}

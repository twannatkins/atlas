{
  "agent_name": "referral-rationale-drafter",
  "version": "1.0.0",
  "phase": 1,
  "posture": "probabilistic-human-in-loop",
  "description": "Drafts narrative rationale for a referral; never auto-files. Output requires human approval before commit.",
  "owner": "atlas-platform-team",
  "model_risk_classification": "tier-3-probabilistic",
  "mrm_submission_ref": "agentic-semantic-layer/docs/model-risk-review.md#rationale-drafter",
  "runtime": {
    "type": "lambda",
    "handler": "referral_rationale_drafter.handler",
    "runtime": "python3.12",
    "timeout_seconds": 45,
    "memory_mb": 1024,
    "environment_variables": {
      "SPARQL_MCP_ARN": "${atlas_sparql_mcp_arn}",
      "BEDROCK_TEXT_MODEL_ID": "anthropic.claude-sonnet-4-20250514-v1:0",
      "PROMPT_TEMPLATE_S3_URI": "s3://atlas-workshop-2/prompts/rationale-template.txt"
    }
  },
  "iam_policy": {
    "inline_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {"Effect": "Allow", "Action": ["bedrock:InvokeModel"], "Resource": "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-*"},
        {"Effect": "Allow", "Action": ["lambda:InvokeFunction"], "Resource": "${atlas_sparql_mcp_arn}"},
        {"Effect": "Allow", "Action": ["s3:GetObject"], "Resource": "arn:aws:s3:::atlas-workshop-2/prompts/*"},
        {"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/referral-rationale-drafter:*"}
      ]
    }
  },
  "input_schema": {
    "type": "object",
    "required": ["household_uri", "signal_uris", "persona_claim"],
    "properties": {
      "household_uri": {"type": "string"},
      "signal_uris": {"type": "array", "items": {"type": "string"}},
      "persona_claim": {"type": "string"}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["status", "draft_narrative", "is_probabilistic", "requires_human_review", "provenance"],
    "properties": {
      "status": {"type": "string", "enum": ["success", "context_query_failed", "generation_failed"]},
      "draft_narrative": {"type": "string", "description": "The drafted rationale; never committed without human approval"},
      "is_probabilistic": {"type": "boolean", "const": true},
      "requires_human_review": {"type": "boolean", "const": true},
      "provenance": {"type": "object", "properties": {"signals_referenced": {"type": "array"}, "context_queries": {"type": "array"}, "prompt_template_version": {"type": "string"}, "model_id": {"type": "string"}}}
    }
  },
  "registry_metadata": {
    "discoverable_by": ["atlas-consumer-banker"],
    "display_name": "Draft referral rationale",
    "display_icon": "message-2",
    "capability_tag": "human-in-loop",
    "phase": 1
  },
  "dependencies": {
    "mcp_servers": ["atlas-sparql-mcp"],
    "workshop_1_artifacts": ["agentic-semantic-layer/ontology/atlas-shapes.ttl"]
  }
}

# Wholesale UI environment — TEMPLATE. Copy to .env.local and fill from your deployed
# AtlasWorkshop2 stack outputs (do NOT commit .env.local; it holds your account values).
#
#   cp .env.example .env.local
#
# Next.js output:"export" inlines NEXT_PUBLIC_* at BUILD time, so set these before
# `next build` and rebuild if they change. See spec/02-prerequisites.md ("Set these once").

# GraphQL endpoint — stack output: AppSyncEndpoint
NEXT_PUBLIC_APPSYNC_ENDPOINT=https://<your-appsync-id>.appsync-api.<region>.amazonaws.com/graphql

# Cognito app client id — stack output: CognitoUserPoolWebClientId
NEXT_PUBLIC_COGNITO_CLIENT_ID=<your-cognito-app-client-id>

# Cognito hosted-UI base URL — stack output: CognitoHostedUiDomain
# (https://<prefix>.auth.<region>.amazoncognito.com)
NEXT_PUBLIC_COGNITO_DOMAIN=https://<your-cognito-domain-prefix>.auth.<region>.amazoncognito.com
